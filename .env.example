# Copiar a .env y completar. El servidor lo carga solo (process.loadEnvFile).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dipolo
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
PORT=3001

# Web Push (opcional — sin esto la app funciona, solo no hay notificaciones).
# Generar el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dipolo.com
