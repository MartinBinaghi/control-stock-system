# Copiar a .env y completar. El servidor lo carga solo (process.loadEnvFile).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dipolo
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
PORT=3001

# URL pública de la app: se usa en los links de los emails de verificación
# e invitación. En dev, la del frontend de Vite.
APP_URL=http://localhost:5173

# SMTP para enviar los emails de verificación e invitación (cualquier
# proveedor: Gmail con app password, Resend, Brevo, etc.).
# Sin SMTP_HOST, los links se imprimen en la consola del servidor (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push (opcional — sin esto la app funciona, solo no hay notificaciones).
# Generar el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dipolo.com
